<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Flat tilt</name>
  <id>org.vector3dit.flat</id>
  <param name="kind" type="string" gui-hidden="true">flat</param>
  <param name="tab" type="notebook"><page name="shape" gui-text="Shape"><label appearance="header">Keeps the artwork paper-thin and tilts it in space: lay art on a floor, a wall or the side of an isometric box.</label></page><page name="view" gui-text="View"><param name="keep_rotation" type="bool" gui-text="Objects that are already 3D keep their rotation" gui-description="Untick to apply the angles below to them too. Tip: Extensions › Vector 3Dit › Rotate in 3D lets you drag to turn objects with a live preview.">true</param><param name="view" type="optiongroup" appearance="combo" gui-text="Preset view"><option value="custom">Use the angles below</option><option value="offaxis">Off-axis</option><option value="offaxis-l">Off-axis left</option><option value="front">Front</option><option value="hero">Low angle</option><option value="iso-l">Isometric left</option><option value="iso-r">Isometric right</option><option value="iso-t">Isometric top</option><option value="top">Top down</option><option value="turn-l">Turned left</option><option value="turn-r">Turned right</option><option value="tilt">Tilted back</option><option value="dimetric">Dimetric</option></param><param name="rx" type="float" min="-180" max="180" gui-text="Tilt (X, °)" precision="1" appearance="full">20</param><param name="ry" type="float" min="-180" max="180" gui-text="Turn (Y, °)" precision="1" appearance="full">-30</param><param name="rz" type="float" min="-180" max="180" gui-text="Spin (Z, °)" precision="1" appearance="full">0</param><param name="persp" type="float" min="0" max="160" gui-text="Perspective (field of view, °)" precision="1" appearance="full" gui-description="0 = no perspective">0</param></page><page name="surface" gui-text="Surface"><param name="material" type="optiongroup" appearance="combo" gui-text="Material preset" gui-description="A preset overrides the shading settings below"><option value="custom">Use the settings below</option><option value="glossy">Glossy</option><option value="clay">Clay</option><option value="toon">Toon</option><option value="poster">Poster</option><option value="chrome">Chrome</option><option value="gold">Gold</option><option value="copper">Copper</option><option value="lineart">Line art</option><option value="wire">Wireframe</option><option value="flat">Flat color</option></param><param name="shading" type="optiongroup" appearance="combo" gui-text="Shading"><option value="plastic">Glossy</option><option value="matte">Matte</option><option value="toon">Toon</option><option value="metal">Metal</option><option value="flat">Flat</option><option value="lineart">Line art</option><option value="wire">Wireframe</option></param><param name="smooth" type="bool" gui-text="Smooth gradients on curved surfaces">true</param><param name="steps" type="int" min="0" max="10" gui-text="Color bands (0 = smooth)" appearance="full">0</param><param name="smooth_angle" type="float" min="0" max="90" gui-text="Smoothing angle (°)" precision="1" appearance="full">35</param><param name="use_side_color" type="bool" gui-text="Custom side color" gui-description="Off: the sides use the shape's own fill">false</param><param name="side_color" type="color" appearance="colorbutton" gui-text="Side color">3295943423</param><param name="shadow_tint" type="optiongroup" appearance="combo" gui-text="Shadow tone"><option value="auto">Tinted</option><option value="black">Black</option></param><param name="highlight" type="color" appearance="colorbutton" gui-text="Highlight color">4294967295</param></page><page name="light" gui-text="Light"><param name="light_az" type="float" min="-180" max="180" gui-text="Direction (°, 0 = front, − = left)" precision="1" appearance="full">-45</param><param name="light_el" type="float" min="-89" max="89" gui-text="Height (°)" precision="1" appearance="full">40</param><param name="intensity" type="float" min="0" max="200" gui-text="Intensity (%)" precision="1" appearance="full">100</param><param name="ambient" type="float" min="0" max="100" gui-text="Ambient (%)" precision="1" appearance="full">35</param><param name="fill_light" type="float" min="0" max="100" gui-text="Fill light (%)" precision="1" appearance="full">25</param><param name="specular" type="float" min="0" max="150" gui-text="Highlight (%)" precision="1" appearance="full">45</param><param name="gloss" type="float" min="0" max="100" gui-text="Gloss" precision="1" appearance="full">55</param></page><page name="extras" gui-text="Outlines &amp; shadow"><param name="edges" type="optiongroup" appearance="combo" gui-text="Edge lines"><option value="none">None</option><option value="outline">Outline and sharp edges</option><option value="all">Every facet</option></param><param name="edge_color" type="color" appearance="colorbutton" gui-text="Line color">454828799</param><param name="edge_width" type="float" min="0.1" max="20" gui-text="Line width (px)" precision="1" appearance="full">1.5</param><param name="crease_angle" type="float" min="5" max="120" gui-text="Crease angle (°)" precision="1" appearance="full">40</param><param name="shadow" type="optiongroup" appearance="combo" gui-text="Shadow"><option value="none">None</option><option value="drop">Cast onto the page</option><option value="floor">Soft floor shadow</option></param><param name="shadow_opacity" type="float" min="0" max="100" gui-text="Shadow opacity (%)" precision="1" appearance="full">28</param><param name="shadow_blur" type="float" min="0" max="100" gui-text="Shadow softness (px)" precision="1" appearance="full">6</param><param name="shadow_dist" type="float" min="0" max="1000" gui-text="Shadow distance (px)" precision="1" appearance="full">40</param><param name="shadow_color" type="color" appearance="colorbutton" gui-text="Shadow color">269622015</param><param name="seam" type="float" min="0" max="3" gui-text="Seam fix (px)" precision="1" appearance="full" gui-description="Hairline strokes that hide gaps between faces">1</param></page><page name="help" gui-text="Help"><label>Select shapes (or a group) and run the effect. Text must be converted first: Path › Object to Path.</label><label>The result is a group of plain vector faces. It keeps the original shape hidden inside, so running any Vector 3Dit effect on it again re-renders it with the new settings.</label><label>Extensions › Vector 3Dit › Rotate in 3D opens a window with a trackball and a live preview: drag to turn objects and see where they land on the page.</label><label>Extensions › Vector 3Dit › Remove 3D puts the original flat shape back.</label><label>Tip: tick Live preview to see changes as you edit.</label></page></param>
  <effect needs-live-preview="true">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Vector 3Dit"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">vector3dit.py</command>
  </script>
</inkscape-extension>
